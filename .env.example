# Copy to .env and fill in. Never commit .env. Switch environments by changing KALSHI_ENV.
KALSHI_ENV=demo                       # demo | prod

KALSHI_DEMO_API_KEY_ID=your-demo-key-id
KALSHI_DEMO_PRIVATE_KEY_PATH=./secrets/kalshi_demo.pem

KALSHI_PROD_API_KEY_ID=your-prod-key-id
KALSHI_PROD_PRIVATE_KEY_PATH=./secrets/kalshi_prod.pem

COURTSIDE_TOKEN=generate-with-scripts/serve.py---gen-token
# COURTSIDE_ALLOW_LIVE=1   # prod live trading (Milestone 5 only)
